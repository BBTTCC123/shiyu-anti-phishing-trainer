/* 识渔计划 小程序全局样式（深色科技风，与 H5 同色系） */
page {
  background: #070b14;
  color: #d7e3f4;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}
.card {
  background: #111a2c; border: 1rpx solid #1c2b45; border-radius: 24rpx;
  padding: 26rpx; margin: 20rpx 24rpx;
}
.card h3 { font-size: 30rpx; color: #35e0c8; font-weight: 700; margin-bottom: 12rpx; }
.btn-main {
  display: block; margin: 22rpx 24rpx; padding: 30rpx 28rpx; text-align: left;
  background: #111a2c; border: 1rpx solid #1c2b45; border-radius: 24rpx; color: #d7e3f4;
  font-size: 32rpx; box-shadow: none;
}
.btn-main.warn { border-color: rgba(255,84,112,.5); }
.btn-main .bt { display: block; color: #fff; font-weight: 700; font-size: 33rpx; margin-bottom: 6rpx; }
.btn-main.warn .bt { color: #ff5470; }
.btn-main .bs { font-size: 23rpx; color: #7e8fa8; }
.btn-main:active { border-color: #35e0c8; }
.dim { color: #7e8fa8; font-size: 24rpx; }
.cy { color: #35e0c8; } .rd { color: #ff5470; } .am { color: #ffb84d; }
.hint { font-size: 24rpx; color: #ffb84d; text-align: center; margin: 18rpx 0; }
.section { font-size: 26rpx; color: #7e8fa8; margin: 26rpx 30rpx 8rpx; letter-spacing: 2rpx; }
