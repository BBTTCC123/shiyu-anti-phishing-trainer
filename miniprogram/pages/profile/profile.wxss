.rep-grid { display: flex; gap: 14rpx; margin: 20rpx 24rpx; }
.rep-box { flex: 1; background: #111a2c; border: 1rpx solid #1c2b45; border-radius: 20rpx; padding: 22rpx 8rpx; text-align: center; }
.rep-box .v { font-size: 52rpx; font-weight: 800; color: #35e0c8; }
.rep-box .v.up { color: #ffb84d; font-size: 44rpx; }
.rep-box .k { font-size: 21rpx; color: #7e8fa8; margin-top: 4rpx; }
.rankline { text-align: center; color: #ffb84d; font-size: 25rpx; }
.ct { font-size: 30rpx; color: #35e0c8; font-weight: 700; margin-bottom: 10rpx; }
.radar { width: 100%; height: 420rpx; }
.drow { font-size: 25rpx; color: #d7e3f4; margin: 8rpx 0; }
.none { font-size: 25rpx; color: #7e8fa8; line-height: 1.9; }
.clear { float: right; font-size: 22rpx; color: #ff5470; }
.wb { border: 1rpx solid #1c2b45; border-radius: 16rpx; padding: 16rpx 20rpx; margin: 12rpx 0; background: #0d1524; }
.wb-t { font-size: 25rpx; font-weight: 700; color: #fff; }
.wb-d { font-size: 22rpx; color: #d7e3f4; margin-top: 6rpx; }
