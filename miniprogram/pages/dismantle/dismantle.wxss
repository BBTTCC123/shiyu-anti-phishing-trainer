.board { margin: 16rpx 24rpx; border: 1rpx solid #1c2b45; border-radius: 24rpx; background: #111a2c; padding: 22rpx; }
.chips { position: relative; min-height: 260rpx; margin-bottom: 24rpx; }
.chip-ev { position: absolute; padding: 14rpx 20rpx; border-radius: 16rpx; font-size: 23rpx;
  background: #0d1524; border: 1rpx solid rgba(255,184,77,.5); max-width: 60%; word-break: break-all; }
.chip-ev.locked { opacity: .4; border-color: rgba(53,224,200,.5); }
.slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.slot { min-height: 130rpx; border: 3rpx dashed #1c2b45; border-radius: 16rpx; padding: 10rpx 12rpx; font-size: 21rpx; color: #7e8fa8; }
.slot b { display: block; font-size: 22rpx; color: #d7e3f4; margin-bottom: 6rpx; }
.placed-wrap { display: flex; flex-wrap: wrap; gap: 6rpx; }
.placed { padding: 3rpx 10rpx; border-radius: 8rpx; background: rgba(53,224,200,.12); color: #35e0c8; font-size: 19rpx; }
.placed.miss { background: rgba(255,84,112,.14); color: #ff5470; }
.v-head { text-align: center; font-size: 32rpx; font-weight: 800; color: #35e0c8; margin: 16rpx 0; }
.flaw { border: 1rpx solid #1c2b45; border-left: 6rpx solid #7e8fa8; border-radius: 16rpx; padding: 16rpx 20rpx; margin: 14rpx 0; }
.flaw.hit { border-left-color: #35e0c8; }
.flaw.miss { border-left-color: #ff5470; }
.f-t { font-size: 25rpx; font-weight: 700; color: #fff; }
.f-d { font-size: 23rpx; color: #d7e3f4; margin-top: 4rpx; word-break: break-all; }
