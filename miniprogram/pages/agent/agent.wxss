.ag-head { padding: 22rpx 26rpx 8rpx; font-size: 28rpx; color: #fff; }
.ag-head .badge { font-size: 20rpx; color: #35e0c8; margin-left: 8rpx; }
.ag-tabs { display: flex; gap: 14rpx; padding: 12rpx 24rpx; }
.tab { flex: 1; text-align: center; font-size: 26rpx; padding: 12rpx 0; border: 1rpx solid #1c2b45; border-radius: 14rpx; color: #7e8fa8; }
.tab.on { color: #35e0c8; border-color: rgba(53,224,200,.45); background: rgba(53,224,200,.08); }
.diag { padding: 0 24rpx; }
.intro { font-size: 23rpx; color: #d7e3f4; line-height: 1.8; padding: 10rpx 0; }
textarea { width: auto; min-height: 180rpx; background: #0d1524; border: 1rpx solid #1c2b45; border-radius: 16rpx; padding: 18rpx; font-size: 25rpx; color: #d7e3f4; }
.go { margin-top: 16rpx; background: rgba(255,84,112,.15) !important; color: #ff5470 !important; border: 1rpx solid rgba(255,84,112,.5); border-radius: 14rpx; font-weight: 700; font-size: 27rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.chip { font-size: 21rpx; color: #35e0c8; border: 1rpx solid rgba(53,224,200,.5); border-radius: 30rpx; padding: 8rpx 18rpx; background: #0d1524; }
.chat { padding: 12rpx 24rpx 160rpx; display: flex; flex-direction: column; gap: 18rpx; }
.m { display: flex; gap: 12rpx; }
.m.u { justify-content: flex-end; }
.m.u .bubble { background: rgba(53,224,200,.14); border: 1rpx solid rgba(53,224,200,.4); }
.ava { width: 60rpx; height: 60rpx; border-radius: 50%; background: radial-gradient(circle at 32% 28%, rgba(53,224,200,.5), #0d1524);
  border: 1rpx solid rgba(53,224,200,.6); display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex: none; }
.bubble { max-width: 76%; border-radius: 8rpx 22rpx 22rpx 22rpx; padding: 16rpx 20rpx; font-size: 24rpx;
  background: #0d1524; border: 1rpx solid #1c2b45; word-break: break-all; white-space: pre-line; }
.tag { align-self: flex-start; margin: 0 0 4rpx 74rpx; font-size: 19rpx; font-weight: 800; padding: 2rpx 16rpx; border-radius: 20rpx; }
.tag.high { background: rgba(255,84,112,.2); color: #ff5470; border: 1rpx solid rgba(255,84,112,.6); }
.tag.mid { background: rgba(255,184,77,.16); color: #ffb84d; border: 1rpx solid rgba(255,184,77,.5); }
.tag.low { background: rgba(53,224,200,.14); color: #35e0c8; border: 1rpx solid rgba(53,224,200,.5); }
.inputbar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 14rpx; padding: 16rpx 24rpx 30rpx; background: #070b14; }
.inputbar input { flex: 1; background: #0d1524; border: 1rpx solid #1c2b45; border-radius: 16rpx; padding: 16rpx 20rpx; font-size: 25rpx; color: #d7e3f4; }
.inputbar button { background: rgba(53,224,200,.15) !important; color: #35e0c8 !important; border-radius: 16rpx; font-size: 25rpx; margin: 0; }

/* 判定行着色（替代独立标签） */
.bubble { display: flex; flex-direction: column; }
.lv { font-weight: 800; }
.lv-high { color: #ff5470; }
.lv-mid { color: #ffb84d; }
.lv-low { color: #35e0c8; }
